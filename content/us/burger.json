  "steps": [
    {
      "text": "Разделите {beef_mince} говяжьего фарша на 2 части и сформуйте котлеты шире булочки."
    },
    {
      "text": "Посолите и поперчите котлеты, обжарьте на раскалённой сковороде по 3–4 минуты с каждой стороны.",
      "timerMinutes": 7
    },
    {
      "text": "В конце разложите на котлеты {cheese} сыра и накройте крышкой на минуту.",
      "timerMinutes": 1
    },
    {
      "text": "Подрумяньте {buns} булочек срезом вниз.",
      "timerMinutes": 1
    },
    {
      "text": "Соберите бургер: {ketchup} кетчупа, {lettuce} салата, котлета, {tomato} помидора, {pickles} огурцов и {red_onion} красного лука."
    }
  ]
