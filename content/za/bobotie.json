  "steps": [
    {
      "text": "Замочите {bread} белого хлеба в половине {milk} молока."
    },
    {
      "text": "Обжарьте {onion} лука на {oil} растительного масла, добавьте {curry_powder} карри и {beef_mince} говяжьего фарша.",
      "timerMinutes": 10
    },
    {
      "text": "Вмешайте отжатый хлеб, {apricot_jam} абрикосового джема, {raisins} изюма и соль, выложите в форму."
    },
    {
      "text": "Взбейте {egg} яиц с оставшимся молоком, залейте фарш и воткните {bay_leaf} лавровых листа."
    },
    {
      "text": "Запекайте при 180 °C, пока заливка не схватится.",
      "timerMinutes": 35
    }
