  "steps": [
    {
      "text": "Нарежьте {beef} говядины очень тонкими ломтиками, посолите и обжарьте порциями.",
      "timerMinutes": 8
    },
    {
      "text": "Обжарьте {tomato_paste} томатной пасты, добавьте {tomato} помидоров тёртыми и 100 мл воды, уварите соус.",
      "timerMinutes": 10
    },
    {
      "text": "Нарежьте {pita} питы кусочками и подсушите на сковороде.",
      "timerMinutes": 3
    },
    {
      "text": "Выложите хлеб, сверху мясо, полейте соусом, рядом положите {yogurt} йогурта."
    },
    {
      "text": "Растопите {butter} сливочного масла с {paprika} паприки до шипения и полейте мясо."
    }
  ]
}
