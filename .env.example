# Copy to .env in the repository root and adjust. Never commit .env.

# --- Mini app (apps/web). Only VITE_* reach the client bundle: no secrets here. ---
# Base URL of the backend API (nginx proxies /api to the Node server).
VITE_API_URL=/api
# Dev-only switches. `npm run dev` already defaults to VITE_TG_MOCK=1 and VITE_API=mock
# (apps/web/vite.config.ts), and a production `vite build` fails if they are set to the mock
# values, so keep them commented out here; uncomment only to override in dev.
# 1 — mock Telegram environment in the browser.
# VITE_TG_MOCK=1
# mock — MSW fixtures, local — local Node server + Postgres.
# VITE_API=local

# --- Server (apps/server) ---
# Local Postgres from docker-compose.yml (dev credentials, not a secret).
DATABASE_URL=postgres://tma80:tma80@127.0.0.1:5433/tma80
PORT=3080

# --- Local Docker Compose ---
# Host port of the local Postgres container (5433 so it does not clash with a system Postgres).
POSTGRES_PORT=5433
