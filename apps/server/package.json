{
  "name": "@tma80/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "worker": "node src/worker/index.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.env src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env seed/seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env seed/reset.ts",
    "db:seed:dev": "node --env-file-if-exists=../../.env seed/devUsers.ts",
    "bot:setup": "node --env-file-if-exists=../../.env src/bot/setup.ts",
    "payments:refund": "node --env-file-if-exists=../../.env src/bot/refundCli.ts",
    "metrics": "node --env-file-if-exists=../../.env src/metrics/cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@tma80/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
