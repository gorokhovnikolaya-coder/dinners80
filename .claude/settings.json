{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm exec:*)",
      "Bash(npx playwright:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(docker ps:*)",
      "WebFetch(domain:core.telegram.org)",
      "WebFetch(domain:docs.telegram-mini-apps.com)",
      "WebFetch(domain:redux-toolkit.js.org)",
      "WebFetch(domain:redux.js.org)",
      "WebFetch(domain:fastify.dev)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:nginx.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:docs.npmjs.com)",
      "WebFetch(domain:grammy.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:mswjs.io)",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./apps/server/.env)",
      "Read(./deploy/.env)",
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh", "timeout": 300 }]
      }
    ]
  }
}
