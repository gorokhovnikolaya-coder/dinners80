# Production variables (decision 0025). On the VPS: cp env.example .env in deploy/, fill in,
# chmod 600 .env. deploy/.env never goes to git. Steps — docs/deploy.md.

# Domain of the mini app (DNS A record → the VPS). nginx, the TLS certificate and the bot use it:
# WEBAPP_URL = https://<DOMAIN>/, the webhook = https://<DOMAIN>/api/bot/webhook.
DOMAIN=
# E-mail for Let's Encrypt (expiry notices), used by deploy/scripts/init-cert.sh.
LETSENCRYPT_EMAIL=

# Bot username without @ and the short name of the mini app from @BotFather (/newapp). They build
# the invite link https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME> for both the client and the server.
BOT_USERNAME=
APP_SHORT_NAME=
# Secret: the token of the production bot from @BotFather.
BOT_TOKEN=

# Postgres passwords: letters and digits only (they go into a URL), e.g. `openssl rand -hex 24`.
# POSTGRES_PASSWORD — the superuser `postgres` (backups, maintenance); APP_DB_PASSWORD — the role
# `tma80` of the server. Both are set once, on the first start with an empty database volume.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Secret of the signed links to private photos (≥ 32 characters [A-Za-z0-9_-]), `openssl rand -hex 32`.
MEDIA_SIGNING_KEY=

# Documents and support (empty — the bot shows placeholders, the profile hides the links).
# TERMS_URL / PRIVACY_URL also go into the mini app build: rebuild nginx after changing them.
TERMS_URL=
PRIVACY_URL=
# @username or e-mail for /paysupport.
SUPPORT_CONTACT=

# Backups (deploy/scripts/backup.sh): rclone remote and folder from deploy/rclone.conf, e.g.
# backup:tma80-backups; how many daily copies to keep, here and in the remote.
BACKUP_REMOTE=
BACKUP_KEEP=14
